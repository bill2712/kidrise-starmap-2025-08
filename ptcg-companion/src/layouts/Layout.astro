---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { title = "PTCG Companion", description = "Live Damage Counter & Match Assistant" } = Astro.props;
---

<!doctype html>
<html lang="zh-TW">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <!-- Global site tag (gtag.js) - Google Analytics -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-9R61GZ220P"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-9R61GZ220P');
    </script>
  </head>
  <body class="bg-black text-white min-h-screen selection:bg-gray-800">
    <slot />
  </body>
</html>
