---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { title = "PTCG Companion", description = "Live Damage Counter & Match Assistant" } = Astro.props;
---

<!doctype html>
<html lang="zh-TW">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body class="bg-black text-white min-h-screen selection:bg-gray-800">
    <slot />
  </body>
</html>
