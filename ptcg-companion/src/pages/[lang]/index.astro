---
import Layout from '../../layouts/Layout.astro';
import PTCGCounter from '../../components/PTCGCounter';
import { langs } from '../../locales/translations';

export function getStaticPaths() {
  return langs.map(lang => ({ params: { lang } }));
}

const { lang } = Astro.params;
---

<Layout title={`PTCG Companion - ${lang}`}>
  <main class="w-full min-h-screen bg-black flex items-center justify-center">
    <PTCGCounter lang={lang} client:load />
  </main>
</Layout>
